{
  "expo": {
    "name": "مدرسة حبر",
    "slug": "ecole-hebr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hebr",
    "userInterfaceStyle": "light",
    "primaryColor": "#7B1E3A",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3E9DC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dz.ecole.hebr",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Permet de prendre une photo pour votre profil scolaire.",
        "NSPhotoLibraryUsageDescription": "Permet de sélectionner une photo depuis votre galerie pour votre profil.",
        "NSMicrophoneUsageDescription": "Permet d'enregistrer des messages vocaux dans le chat scolaire."
      }
    },
    "android": {
      "package": "dz.ecole.hebr",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3E9DC"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos pour personnaliser votre profil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
